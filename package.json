{
  "name": "hack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx --env-file=.env.local scripts/sync-candles.ts",
    "patterns": "tsx --env-file=.env.local scripts/detect-patterns.ts",
    "validate": "tsx --env-file=.env.local scripts/validate-candles.ts",
    "test": "tsx --env-file=.env.local --test tests/*.test.ts",
    "train": "NODE_OPTIONS=--max-old-space-size=6144 tsx --env-file=.env.local scripts/train-model.ts"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

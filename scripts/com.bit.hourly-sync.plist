<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS background job: runs scripts/hourly-sync.ts at minute 31 of every hour
  (local time). In IST (+05:30) Binance's 1h candles close at :30, so :31 picks
  up each candle a minute after it closes. If the Mac was asleep, launchd runs
  the job on wake and the script catches up every missed hour.

  Install:   cp scripts/com.bit.hourly-sync.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.bit.hourly-sync.plist
  Run now:   launchctl start com.bit.hourly-sync
  Uninstall: launchctl unload ~/Library/LaunchAgents/com.bit.hourly-sync.plist && rm ~/Library/LaunchAgents/com.bit.hourly-sync.plist
  Log:       ~/Library/Logs/bit-hourly-sync.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bit.hourly-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ethan/.nvm/versions/node/v22.18.0/bin/node</string>
    <string>/Users/ethan/Projects/Personal Projects/bit/hack/node_modules/tsx/dist/cli.mjs</string>
    <string>--env-file=.env.local</string>
    <string>scripts/hourly-sync.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ethan/Projects/Personal Projects/bit/hack</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>31</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ethan/Library/Logs/bit-hourly-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ethan/Library/Logs/bit-hourly-sync.log</string>
</dict>
</plist>
